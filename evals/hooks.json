{
  "description": "Routing decisions of the read guards, as a host-neutral table. {{DIR}} is the fixture directory (fixtures/generate.sh output plus fixtures/warehouse). Thresholds: 600 lines / 6000 tokens, slices up to 600 lines.",
  "read": [
    { "name": "small source file", "input": { "file_path": "{{DIR}}/warehouse/inventory.ts" }, "expect": "allow" },
    { "name": "large module, full read", "input": { "file_path": "{{DIR}}/ledger.ts" }, "expect": "deny" },
    { "name": "large log, full read", "input": { "file_path": "{{DIR}}/ci.log" }, "expect": "deny" },
    { "name": "large module, 200-line slice", "input": { "file_path": "{{DIR}}/ledger.ts", "offset": 300, "limit": 200 }, "expect": "allow" },
    { "name": "large module, 600-line slice (at the cap)", "input": { "file_path": "{{DIR}}/ledger.ts", "offset": 1, "limit": 600 }, "expect": "allow" },
    { "name": "large module, 601-line slice", "input": { "file_path": "{{DIR}}/ledger.ts", "offset": 1, "limit": 601 }, "expect": "deny" },
    { "name": "offset near the end, no limit", "input": { "file_path": "{{DIR}}/ledger.ts", "offset": 800 }, "expect": "allow" },
    { "name": "offset at the start, no limit (= full read)", "input": { "file_path": "{{DIR}}/ledger.ts", "offset": 1 }, "expect": "deny" },
    { "name": "limit 0", "input": { "file_path": "{{DIR}}/ledger.ts", "limit": 0 }, "expect": "allow" },
    { "name": "missing file", "input": { "file_path": "{{DIR}}/nope.ts" }, "expect": "allow" },
    { "name": "empty path", "input": { "file_path": "" }, "expect": "allow" },
    { "name": "no tool_input fields", "input": {}, "expect": "allow" },
    { "name": "binary file", "input": { "file_path": "{{DIR}}/blob.bin" }, "expect": "allow" },
    { "name": "secret file is left to the host", "input": { "file_path": "{{DIR}}/.env" }, "expect": "allow" },
    { "name": "threshold lowered by env", "input": { "file_path": "{{DIR}}/warehouse/inventory.ts" }, "env": { "OFFLOAD_MIN_LINES": "50" }, "expect": "deny" },
    { "name": "many short lines, default thresholds", "input": { "file_path": "{{DIR}}/short-lines.txt" }, "expect": "deny" },
    { "name": "many short lines, line threshold raised by env", "input": { "file_path": "{{DIR}}/short-lines.txt" }, "env": { "OFFLOAD_MIN_LINES": "5000" }, "expect": "allow" },
    { "name": "line threshold raised, token threshold still applies", "input": { "file_path": "{{DIR}}/ledger.ts" }, "env": { "OFFLOAD_MIN_LINES": "5000" }, "expect": "deny" },
    { "name": "non-numeric env ignored", "input": { "file_path": "{{DIR}}/ledger.ts" }, "env": { "OFFLOAD_MIN_LINES": "lots" }, "expect": "deny" },
    { "name": "guard off", "input": { "file_path": "{{DIR}}/ledger.ts" }, "env": { "OFFLOAD_READ_GUARD": "off" }, "expect": "allow" },
    { "name": "guard ask", "input": { "file_path": "{{DIR}}/ledger.ts" }, "env": { "OFFLOAD_READ_GUARD": "ask" }, "expect": "ask" },
    { "name": "disabled", "input": { "file_path": "{{DIR}}/ledger.ts" }, "env": { "OFFLOAD_DISABLE": "1" }, "expect": "allow" }
  ],
  "bash": [
    { "name": "cat large module", "command": "cat {{DIR}}/ledger.ts", "expect": "deny" },
    { "name": "cat -n large module", "command": "cat -n {{DIR}}/ledger.ts", "expect": "deny" },
    { "name": "quoted path", "command": "cat \"{{DIR}}/ledger.ts\"", "expect": "deny" },
    { "name": "nl", "command": "nl {{DIR}}/ledger.ts", "expect": "deny" },
    { "name": "less", "command": "less {{DIR}}/ci.log", "expect": "deny" },
    { "name": "more", "command": "more {{DIR}}/ci.log", "expect": "deny" },
    { "name": "cat small file", "command": "cat {{DIR}}/warehouse/pricing.py", "expect": "allow" },
    { "name": "head default (10 lines)", "command": "head {{DIR}}/ledger.ts", "expect": "allow" },
    { "name": "tail default (10 lines)", "command": "tail {{DIR}}/ci.log", "expect": "allow" },
    { "name": "head -n 100", "command": "head -n 100 {{DIR}}/ledger.ts", "expect": "allow" },
    { "name": "head -2000", "command": "head -2000 {{DIR}}/ledger.ts", "expect": "deny" },
    { "name": "tail -n1500", "command": "tail -n1500 {{DIR}}/ci.log", "expect": "deny" },
    { "name": "tail -f", "command": "tail -f {{DIR}}/ci.log", "expect": "allow" },
    { "name": "tail -n without a value", "command": "tail -n", "expect": "allow" },
    { "name": "sed small range", "command": "sed -n '100,160p' {{DIR}}/ledger.ts", "expect": "allow" },
    { "name": "sed huge range", "command": "sed -n '1,900p' {{DIR}}/ledger.ts", "expect": "deny" },
    { "name": "sed to end", "command": "sed -n '5,$p' {{DIR}}/ledger.ts", "expect": "deny" },
    { "name": "sed substitution", "command": "sed 's/a/b/' {{DIR}}/ledger.ts", "expect": "allow" },
    { "name": "pipe to grep", "command": "cat {{DIR}}/ledger.ts | grep LATE_FEE", "expect": "allow" },
    { "name": "redirect", "command": "cat {{DIR}}/ledger.ts > /dev/null", "expect": "allow" },
    { "name": "chained", "command": "cd {{DIR}} && cat ledger.ts", "expect": "allow" },
    { "name": "grep", "command": "grep -n applyLateFee {{DIR}}/ledger.ts", "expect": "allow" },
    { "name": "unrelated command", "command": "git status", "expect": "allow" },
    { "name": "missing file", "command": "cat {{DIR}}/nope.ts", "expect": "allow" },
    { "name": "raw escape hatch", "command": "OFFLOAD_RAW=1 cat {{DIR}}/ledger.ts", "expect": "allow" },
    { "name": "offload itself", "command": "offload read -q 'what is MAX_BATCH?' {{DIR}}/ledger.ts", "expect": "allow" },
    { "name": "empty command", "command": "", "expect": "allow" }
  ]
}
