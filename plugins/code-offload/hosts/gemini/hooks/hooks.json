{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "name": "code-offload", "command": "\"${extensionPath}/../../bin/offload-ts\" hook gemini session-start", "timeout": 20000 } ] }
    ],
    "BeforeTool": [
      { "matcher": "read_file|run_shell_command", "hooks": [ { "type": "command", "name": "code-offload", "command": "\"${extensionPath}/../../bin/offload-ts\" hook gemini before-tool", "timeout": 20000 } ] }
    ],
    "AfterTool": [
      { "matcher": "run_shell_command", "hooks": [ { "type": "command", "name": "code-offload", "command": "\"${extensionPath}/../../bin/offload-ts\" hook gemini after-tool", "timeout": 240000 } ] }
    ]
  }
}
