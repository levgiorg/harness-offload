#!/usr/bin/env bash
# PreToolUse(Read): keep whole large files out of Claude's context.
# Targeted reads (offset/limit within hooks.read_max_chunk_lines) pass.
#
# Order matters for speed: this runs before every Read, and nearly all of
# them are small. The size check comes first; the slower checks (ignore
# globs, secrets, is a worker available) run only for a read we would stop.
case "$0" in */*) . "${0%/*}/../lib/hook.sh" ;; *) . ../lib/hook.sh ;; esac

file=$HK_FILE offset=$HK_OFFSET limit=$HK_LIMIT
guard="" chunk=0 max_lines=0 max_tokens=0   # set by co_cfgv/co_cfgi below
[ -n "$file" ] && [ -f "$file" ] || exit 0
co_cfg_bool '.enabled' true || exit 0
co_cfgv guard '.hooks.read_guard' block
[ "$guard" = "off" ] && exit 0

co_cfgi chunk '.hooks.read_max_chunk_lines' 600
co_cfgi max_lines '.hooks.read_threshold_lines' 600
co_cfgi max_tokens '.hooks.read_threshold_tokens' 6000
case "$offset" in ''|*[!0-9]*) offset="" ;; esac
case "$limit" in ''|*[!0-9]*) limit="" ;; esac

# One `wc` settles most reads: newlines + 1 bounds the line count from
# above, so a small whole-file read passes without the exact count.
read -r nl bytes <<EOF
$(wc -lc < "$file" 2>/dev/null)
EOF
case "$nl$bytes" in ''|*[!0-9]*) exit 0 ;; esac
ctx_note=""
if [ -z "$offset" ] && [ -z "$limit" ] && [ $((nl + 1)) -le "$max_lines" ] && [ $(((bytes + 3) / 4)) -le "$max_tokens" ]; then
  # opt-in (hooks.context_tight_tokens): when the agent's context is nearly full, a read
  # over half the limit could force a compaction, so the limit is halved. The transcript
  # is only looked at for files in that band.
  tight=0; co_cfgi tight '.hooks.context_tight_tokens' 0
  if [ "$tight" -gt 0 ] && { [ $((nl + 1)) -gt $((max_lines / 2)) ] || [ $(((bytes + 3) / 4)) -gt $((max_tokens / 2)) ]; } &&
    used=$(hk_context_used) && [ "$used" -ge "$tight" ]; then
    max_lines=$((max_lines / 2)); max_tokens=$((max_tokens / 2))
    ctx_note="
(Your context is nearly full: ~$(co_fmt_int "$used") tokens in use, at or above hooks.context_tight_tokens, so the limit is halved.)"
  else
    exit 0
  fi
fi
lines=$(co_file_lines "$file")

# Would offload stop this read? (ignored, binary, secret or no worker: no)
may_stop() {
  hk_ignored "$file" && return 1
  hk_not_for_offload "$file" && return 1
  hk_may_act
}

if [ -n "$offset" ] || [ -n "$limit" ]; then
  # A targeted read: fine as long as the slice itself is not huge.
  start=${offset:-1}
  [ "$start" -lt 1 ] && start=1
  if [ -n "$limit" ]; then span=$limit; else span=$(( lines - start + 1 )); fi
  remaining=$(( lines - start + 1 ))
  [ "$span" -gt "$remaining" ] && span=$remaining
  # lines averaging over 4,000 characters (minified/generated): count the slice's size too
  avg=$(( bytes / (lines > 0 ? lines : 1) ))
  if [ "$avg" -gt 4000 ] && [ $(( (span * avg + 3) / 4 )) -gt "$max_tokens" ]; then
    may_stop || exit 0
    hk_event read_slice_blocked "$(jq -nc --argjson l "$span" --arg f "$file" '{lines: $l, file: $f}')"
    hk_guard "offload: that Read slice is $(co_fmt_int "$span") lines of $file, but its lines average $(co_fmt_int "$avg") characters (minified or generated): ~$(co_fmt_int $(( (span * avg + 3) / 4 ))) tokens. Bash: grep -noE '.{0,80}PATTERN.{0,80}' $(co_shquote "$file") shows each match with 80 characters around it, or ask: $HK_CLI read -q \"<question>\" $(co_shquote "$file")"
  fi
  [ "$span" -le "$chunk" ] && exit 0
  may_stop || exit 0
  hk_event read_slice_blocked "$(jq -nc --argjson l "$span" --arg f "$file" '{lines: $l, file: $f}')"
  hk_guard "offload: that Read slice is $(co_fmt_int "$span") lines of $file; keep slices to at most $chunk lines (use offset/limit), or ask: $HK_CLI read -q \"<question>\" $(co_shquote "$file"):$start-$(( start + span - 1 ))"
fi

tokens=$(co_est_tokens "$bytes")
[ "$lines" -le "$max_lines" ] && [ "$tokens" -le "$max_tokens" ] && exit 0
may_stop || exit 0

. "$CO_ROOT/lib/outline.sh"
hk_event read_blocked "$(jq -nc --argjson l "$lines" --argjson t "$tokens" --arg f "$file" --arg c "${used:-}" '{lines: $l, tokens: $t, file: $f} + (if $c == "" then {} else {context: ($c | tonumber)} end)')"
hk_guard "$(hk_big_file_message "$file" "$lines" "$tokens" "A full Read")$ctx_note"
