#!/usr/bin/env bash
# offload — hand bulk I/O work to cheap OpenCode models so it never enters
# Claude's context. See `offload help`.

# Resolve symlinks (e.g. ~/.local/bin/offload -> repo) with plain readlink:
# `readlink -f`/`realpath` are missing on older macOS.
src="$0"
while [ -h "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
CO_ROOT="$(cd -P "$(dirname "$src")/.." && pwd)"
unset src dir
# OFFLOAD_ENGINE=ts: the TypeScript engine answers instead (to compare the two
# engines inside one harness; installs never set it).
if [ "${OFFLOAD_ENGINE:-}" = ts ] && [ -x "$CO_ROOT/bin/offload-ts" ]; then
  exec "$CO_ROOT/bin/offload-ts" "$@"
fi
# shellcheck source=../lib/common.sh
. "$CO_ROOT/lib/common.sh"
# shellcheck source=../lib/opencode.sh
. "$CO_ROOT/lib/opencode.sh"
# shellcheck source=../lib/digest.sh
. "$CO_ROOT/lib/digest.sh"
# shellcheck source=../lib/outline.sh
. "$CO_ROOT/lib/outline.sh"

usage() {
  cat <<'EOF'
offload — keep big reads, long logs and repo-wide searches out of your coding agent's context

  offload read -q QUESTION PATH...      Answer a question about files (PATH may be a dir or file:START-END).
                                        Answers cite path:Lx-Ly with quotes; quotes are verified locally.
  offload explore QUESTION              Read-only agent greps/reads the repo itself and answers.
  offload run [-q FOCUS] -- CMD...      Run a noisy command; long output becomes a digest + verbatim
  offload run [-q FOCUS] -c 'CMD'       error lines + full-log path. Exit code is preserved.
  offload summarize [-q FOCUS] [FILE]   Digest text from FILE or stdin (e.g. `git log -p | offload summarize`).
  offload write --spec S --ref FILE [--ref FILE] [--context FILE] [--out PATH] [--check 'CMD']
                                        Generate pattern-following code (tests, boilerplate, configs).
  offload ask [--stdin|-f FILE] QUESTION  One-off question to the cheap model.
  offload task NAME [-q Q] [PATH...]    Run one of your own tasks (offload tasks lists them).
  offload outline FILE                  Symbol outline with line numbers (no model call).

  offload model [TASK] [REF]            Show or change which model does the work (e.g. offload model groq:llama-3.3-70b).
  offload key [NAME] [--remove]         Store an API key (hidden prompt or stdin; file mode 600).
  offload setup                         Wizard: backends, keys, models, harnesses (needs Node 18+).
  offload models [BACKEND]              List the models your backends offer.
  offload doctor [--ping] [--reset]     Check setup; --ping makes a tiny live call per model.
  offload stats [--days N] [--json|--csv] Delegations and estimated tokens saved (14-day sparkline).
  offload explain [N]                   What the hooks did lately (blocked reads, replaced output), why, how to change it.
  offload dashboard [--open] [--sample] HTML report of the same (needs Node 18+).
  offload install                       Asks which agents and where, shows what will change, installs on yes.
  offload uninstall                     The same, in reverse (--yes / --agents / --all to skip the questions).
  offload install|uninstall HOST        Just one harness (claude, codex, cursor, gemini, copilot, qwen, crush, …).
  offload config [show|path|init|set KEY VALUE|trust] [--project]

Models are BACKEND:MODEL (openrouter:qwen/qwen3-coder, ollama:qwen3:8b, claude:haiku), a bare
provider/model means OpenCode, @host (the default) is your harness's own small model, and
@host-api the same model family through an API key (a backup if the plan route stops working).
Common options: -m/--model REF (one-off override), --allow-secrets.
Exit codes: 0 ok · 2 usage · 10 quota/rate limit · 11 auth · 12 timeout · 13 unknown model
            14 worker error · 15 backend missing · 16 refused (secrets/size)
EOF
}

die() { co_err "$1"; exit "${2:-$CO_E_USAGE}"; }

# For option parsers: `need "$@"` before reading "$2" (no endless `shift 2`).
need() { [ $# -ge 2 ] || die "option $1 needs a value"; }

need_jq() { command -v jq >/dev/null 2>&1 || die "jq is required (macOS: brew install jq · Debian/Ubuntu: apt install jq)" "$CO_E_USAGE"; }

# Footer helper: one compact line so Claude knows where the answer came from.
footer() { printf '\n[offload %s%s]\n' "$*" "${CO_OC_FALLBACK:+ · $CO_OC_FALLBACK}"; }

report_failure() {
  local what="$1" rc="$2"
  co_err "$what failed (exit $rc): $CO_OC_ERROR"
  case "$rc" in
    "$CO_E_NOOC") ;;
    "$CO_E_QUOTA") co_err "hint: quota/rate limit — add models.fallback in the config, or do this step yourself." ;;
    "$CO_E_AUTH")  co_err "hint: log the backend in (its own CLI login, or \`opencode auth login\`) or set its API key with \`offload setup\`; \`offload doctor\` shows which." ;;
    "$CO_E_MODEL") co_err "hint: check the model id (\`offload models BACKEND\` lists them) and switch with \`offload model BACKEND:MODEL\`; some providers also say \"model not found\" when the API key is wrong." ;;
    "$CO_E_TIMEOUT") co_err "hint: raise opencode.timeout_seconds or send less input." ;;
    "$CO_E_TOO_LARGE") co_err "hint: send less at once — fewer files, a range (path:START-END) — or pick a model with a bigger context window (\`offload model …\`)." ;;
  esac
}

# ------------------------------------------------------------------ read

# Appends one file (or a line range of it) to the prompt, numbered.
emit_file() {
  local path="$1" from="$2" to="$3" total="$4"
  printf '<file path="%s" lines="%s-%s" total_lines="%s">\n' "$path" "$from" "$to" "$total"
  awk -v a="$from" -v b="$to" 'NR >= a && NR <= b { printf "%6d\t%s\n", NR, $0 } NR > b { exit }' "$path" | co_redact | co_fence
  printf '</file>\n\n'
}

# Lists candidate files under a directory: git-tracked when possible.
list_dir_files() {
  local d="$1"
  if git -C "$d" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$d" ls-files --cached --others --exclude-standard 2>/dev/null | LC_ALL=C sed "s|^|${d%/}/|"
  else
    find "$d" -type f \
      -not -path '*/.git/*' -not -path '*/node_modules/*' -not -path '*/dist/*' -not -path '*/build/*' \
      -not -path '*/.venv/*' -not -path '*/venv/*' -not -path '*/target/*' -not -path '*/vendor/*' 2>/dev/null
  fi | LC_ALL=C sed 's|^\./||' | LC_ALL=C grep -vE '(^|/)(package-lock\.json|yarn\.lock|pnpm-lock\.yaml|Cargo\.lock|poetry\.lock|go\.sum|.*\.min\.(js|css)|.*\.map)$' | sort
}

cmd_read() {
  local question="" model="" verify=true allow_secrets=false use_cache=true
  local -a items
  items=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -q|--question) need "$@"; question="$2"; shift 2 ;;
      -m|--model) need "$@"; model="$2"; shift 2 ;;
      --no-verify) verify=false; shift ;;
      --no-cache) use_cache=false; shift ;;
      --allow-secrets) allow_secrets=true; shift ;;
      --paths) shift ;;  # alias: the paths simply follow
      --) shift; while [ $# -gt 0 ]; do items+=("$1"); shift; done ;;
      -h|--help) usage; exit 0 ;;
      -*) die "read: unknown option $1" ;;
      *) items+=("$1"); shift ;;
    esac
  done
  [ -n "$question" ] || die 'read: -q "QUESTION" is required'
  [ ${#items[@]} -gt 0 ] || die "read: give at least one file or directory"

  local max_bytes max_files prompt answer sentf
  max_bytes=$(co_cfg_int '.read.max_input_bytes' 1500000)
  max_files=$(co_cfg_int '.read.max_files' 60)
  co_tmp prompt; co_tmp answer; co_tmp sentf

  local item path from to total nfiles=0 nlines=0 skipped="" f
  for item in "${items[@]}"; do
    from=""; to=""
    path="$item"
    if [ ! -e "$item" ] && printf '%s' "$item" | grep -qE ':[0-9]+-[0-9]+$'; then
      path="${item%:*}"; from="${item##*:}"; to="${from#*-}"; from="${from%-*}"
    fi
    path="${path#./}"
    if [ -d "$path" ]; then
      while IFS= read -r f; do
        [ -z "$f" ] && continue
        [ -f "$f" ] || continue
        # links inside a directory are not followed (they may point outside it)
        if [ -h "$f" ]; then skipped="$skipped $f(symlink)"; continue; fi
        if co_is_secret_path "$f" && ! $allow_secrets; then skipped="$skipped $f(secret)"; continue; fi
        co_is_text "$f" || continue
        [ "$nfiles" -ge "$max_files" ] && { skipped="$skipped (+more: max_files=$max_files)"; break; }
        total=$(co_file_lines "$f")
        emit_file "$f" 1 "$total" "$total" >> "$prompt"
        printf '%s\n' "$f" >> "$sentf"
        nfiles=$((nfiles + 1)); nlines=$((nlines + total))
      done <<EOF
$(list_dir_files "$path")
EOF
      continue
    fi
    [ -f "$path" ] && [ -r "$path" ] || die "read: file not found or unreadable: $item"
    if co_is_secret_target "$path" && ! $allow_secrets; then
      die "read: refusing to send $path to a third-party model (matches privacy.secret_globs). Use --allow-secrets if you are sure." "$CO_E_REFUSED"
    fi
    co_is_text "$path" || die "read: $path looks binary; offload only handles text" "$CO_E_REFUSED"
    total=$(co_file_lines "$path")
    [ -z "$from" ] && from=1
    [ -z "$to" ] && to=$total
    [ "$to" -gt "$total" ] && to=$total
    emit_file "$path" "$from" "$to" "$total" >> "$prompt"
    printf '%s\n' "$path" >> "$sentf"
    nfiles=$((nfiles + 1)); nlines=$((nlines + to - from + 1))
  done
  [ "$nfiles" -gt 0 ] || die "read: no readable text files to send${skipped:+ (skipped:$skipped)}" "$CO_E_REFUSED"

  local bytes
  bytes=$(co_file_bytes "$prompt")
  if [ "$bytes" -gt "$max_bytes" ]; then
    die "read: $(co_fmt_int "$bytes") bytes is over read.max_input_bytes ($(co_fmt_int "$max_bytes")). Send fewer files, use file:START-END ranges, or try \`offload explore\`." "$CO_E_REFUSED"
  fi
  printf '<question>%s</question>\n' "$question" >> "$prompt"

  # The same question about the same file contents (the prompt holds them) with the same
  # model and instructions: the checked answer from earlier, if it is recent. Twin: cmdRead.
  local cache_s=0 cachef="" c_at c_hms c_ok c_bad c_model
  co_cfgi cache_s '.read.cache_seconds' 3600
  [ "${OFFLOAD_NO_CACHE:-}" = 1 ] && use_cache=false
  if $use_cache && [ "$cache_s" -gt 0 ]; then
    cachef="$(co_state_dir)/cache/answers/$({ cat "$prompt"; printf '\n%s|%s|%s|' "$model" "${CO_TASK_NAME:-}" "$verify"; cat "${CO_TASK_SYSTEM_FILE:-/dev/null}"; } | LC_ALL=C cksum | LC_ALL=C awk '{ print $1 "-" $2 }')"
    if [ -f "$cachef" ] && read -r c_at c_hms c_ok c_bad c_model < "$cachef" && [ $(( $(co_now) - ${c_at:-0} )) -le "$cache_s" ]; then
      tail -n +2 "$cachef"
      footer "${CO_CMD_LABEL:-read} · $c_model · $nfiles file(s), $(co_fmt_int "$nlines") lines (~$(co_fmt_int "$(co_est_tokens "$bytes")") tokens) kept out of your context · 0s$($verify && printf ' · citations: %s verified, %s unverified' "$c_ok" "$c_bad") · cached from $c_hms (--no-cache to ask again)"
      [ "${c_bad:-0}" -gt 0 ] && echo "⚠unverified = quote not found near the cited lines; confirm with Read(offset/limit) before acting on it."
      co_stats_append "$(jq -nc --arg model "$c_model" --argjson files "$nfiles" --argjson bin "$bytes" --argjson bout "$(tail -n +2 "$cachef" | wc -c | tr -d ' ')" \
        '{ts: now | floor, kind: "read", source: "cache", model: $model, files: $files, bytes_in: $bin, bytes_out: $bout,
          saved_tokens: ((($bin - $bout) / 4) | floor | if . < 0 then 0 else . end), seconds: 0, cites_ok: 0, cites_bad: 0,
          worker_tokens_in: 0, worker_tokens_out: 0}')"
      return 0
    fi
  fi

  local t0 rc
  t0=$(co_now)
  co_oc_invoke read "$prompt" "$(co_work_dir)" "$answer" "$model"; rc=$?
  if [ "$rc" != 0 ]; then report_failure "read" "$rc"; exit "$rc"; fi

  local cite="" ok=0 bad=0 rep
  if $verify && co_cfg_bool '.read.verify_citations' true; then
    co_tmp rep
    # files sent from outside this folder (a log in /tmp, another repo) are checked too
    awk -v root="$PWD" -v report="$rep" -v sent="$sentf" -f "$CO_ROOT/lib/verify.awk" "$answer" > "$answer.v" && mv "$answer.v" "$answer"
    read -r ok bad < "$rep" 2>/dev/null || { ok=0; bad=0; }
    # most citations wrong: ask once more with the failures in view, keep the better answer
    local retried=""
    if [ "${bad:-0}" -ge 2 ] && [ "$bad" -gt "$ok" ] && co_cfg_bool '.read.retry_unverified' true; then
      local p2 a2 r2 ok2 bad2 tin1="${CO_OC_TOKENS_IN:-0}" tout1="${CO_OC_TOKENS_OUT:-0}" m1="$CO_OC_MODEL"
      co_tmp p2; co_tmp a2; co_tmp r2
      { cat "$prompt"; printf '<previous_answer>\n'; cat "$answer"; printf '</previous_answer>\n'
        printf '<check>%s</check>\n' "Some citations in your previous answer quote text that is not at the lines they cite (marked ⚠unverified). Answer the question again: copy every quote character for character from the numbered lines it cites, and leave out a claim you cannot cite."
        printf '<question>%s</question>\n' "$question"; } > "$p2"
      if co_oc_invoke read "$p2" "$(co_work_dir)" "$a2" "$model"; then
        awk -v root="$PWD" -v report="$r2" -v sent="$sentf" -f "$CO_ROOT/lib/verify.awk" "$a2" > "$a2.v" && mv "$a2.v" "$a2"
        read -r ok2 bad2 < "$r2" 2>/dev/null || { ok2=0; bad2=$bad; }
        CO_OC_TOKENS_IN=$(( tin1 + ${CO_OC_TOKENS_IN:-0} )); CO_OC_TOKENS_OUT=$(( tout1 + ${CO_OC_TOKENS_OUT:-0} ))
        if [ "$bad2" -lt "$bad" ] || { [ "$bad2" -eq "$bad" ] && [ "$ok2" -gt "$ok" ]; }; then
          retried=" · retried once: $bad → $bad2 unverified"; mv "$a2" "$answer"; ok=$ok2; bad=$bad2
        else
          retried=" · retried once, the first answer was better"; CO_OC_MODEL=$m1
        fi
      else
        retried=" · a retry failed, first answer kept"; CO_OC_MODEL=$m1
        CO_OC_TOKENS_IN=$tin1 CO_OC_TOKENS_OUT=$tout1
      fi
    fi
    cite=" · citations: $ok verified, $bad unverified$retried"
  fi
  cat "$answer"
  if [ -n "$cachef" ]; then
    mkdir -p "${cachef%/*}" 2>/dev/null && { printf '%s %s %s %s %s\n' "$(co_now)" "$(date +%H:%M:%S)" "$ok" "$bad" "$CO_OC_MODEL"; cat "$answer"; } > "$cachef" 2>/dev/null
  fi
  footer "${CO_CMD_LABEL:-read} · $CO_OC_MODEL · $nfiles file(s), $(co_fmt_int "$nlines") lines (~$(co_fmt_int "$(co_est_tokens "$bytes")") tokens) kept out of your context · $(co_elapsed "$t0")s$cite"
  [ "${bad:-0}" -gt 0 ] && echo "⚠unverified = quote not found near the cited lines; confirm with Read(offset/limit) before acting on it."
  [ -n "$skipped" ] && echo "skipped:$skipped"

  local abytes
  abytes=$(co_file_bytes "$answer")
  co_stats_append "$(jq -nc --arg model "$CO_OC_MODEL" --argjson files "$nfiles" --argjson bin "$bytes" --argjson bout "$abytes" \
    --argjson secs "$(co_elapsed "$t0")" --argjson ok "${ok:-0}" --argjson bad "${bad:-0}" \
    --argjson tin "${CO_OC_TOKENS_IN:-0}" --argjson tout "${CO_OC_TOKENS_OUT:-0}" \
    '{ts: now | floor, kind: "read"} + (if env.CO_TASK_NAME then {task: env.CO_TASK_NAME} else {} end) + {model: $model, files: $files, bytes_in: $bin, bytes_out: $bout,
      saved_tokens: ((($bin - $bout) / 4) | floor | if . < 0 then 0 else . end), seconds: $secs,
      cites_ok: $ok, cites_bad: $bad, worker_tokens_in: $tin, worker_tokens_out: $tout}')"
}

# --------------------------------------------------------------- explore

cmd_explore() {
  local question="" model="" dir="$PWD" verify=true
  while [ $# -gt 0 ]; do
    case "$1" in
      -q|--question) need "$@"; question="$2"; shift 2 ;;
      -m|--model) need "$@"; model="$2"; shift 2 ;;
      --dir) need "$@"; dir="$2"; shift 2 ;;
      --no-verify) verify=false; shift ;;
      -h|--help) usage; exit 0 ;;
      --) shift; question="$question${question:+ }$*"; break ;;
      -*) die "explore: unknown option $1" ;;
      *) question="$question${question:+ }$1"; shift ;;
    esac
  done
  [ -n "$question" ] || die 'explore: give a question, e.g. offload explore "where are JWTs validated?"'
  [ -d "$dir" ] || die "explore: no such directory: $dir"
  dir=$(cd "$dir" && pwd)

  local prompt answer t0 rc
  co_tmp prompt; co_tmp answer
  {
    printf 'Investigate the codebase in the current working directory and answer the question.\n\n'
    printf '<question>%s</question>\n' "$question"
  } > "$prompt"
  t0=$(co_now)
  co_oc_invoke explore "$prompt" "$dir" "$answer" "$model"; rc=$?
  if [ "$rc" != 0 ]; then report_failure "explore" "$rc"; exit "$rc"; fi

  local cite="" ok=0 bad=0 rep
  if $verify; then
    co_tmp rep
    # the project's files, so a citation with a shortened path still finds its file
    local knownf
    co_tmp knownf
    ( cd "$dir" 2>/dev/null && { git ls-files --cached --others --exclude-standard 2>/dev/null || find . -type f ! -path './.git/*' ! -path '*/node_modules/*' 2>/dev/null; } | head -n 50000 ) > "$knownf"
    awk -v root="$dir" -v report="$rep" -v known="$knownf" -f "$CO_ROOT/lib/verify.awk" "$answer" > "$answer.v" && mv "$answer.v" "$answer"
    read -r ok bad < "$rep" 2>/dev/null || { ok=0; bad=0; }
    cite=" · citations: $ok verified, $bad unverified"
  fi
  cat "$answer"
  footer "${CO_CMD_LABEL:-explore} · $CO_OC_MODEL · worker read ~$(co_fmt_int "${CO_OC_CTX_IN:-0}") tokens of context for you · $(co_elapsed "$t0")s$cite"
  [ "${bad:-0}" -gt 0 ] && echo "⚠unverified = quote not found near the cited lines; confirm with Read(offset/limit) before acting on it."

  local abytes
  abytes=$(co_file_bytes "$answer")
  co_stats_append "$(jq -nc --arg model "$CO_OC_MODEL" --argjson ctx "${CO_OC_CTX_IN:-0}" --argjson bout "$abytes" \
    --argjson secs "$(co_elapsed "$t0")" --argjson ok "${ok:-0}" --argjson bad "${bad:-0}" \
    --argjson tin "${CO_OC_TOKENS_IN:-0}" --argjson tout "${CO_OC_TOKENS_OUT:-0}" \
    '{ts: now | floor, kind: "explore"} + (if env.CO_TASK_NAME then {task: env.CO_TASK_NAME} else {} end) + {model: $model, bytes_out: $bout,
      saved_tokens: (($ctx - ($bout / 4)) | floor | if . < 0 then 0 else . end), seconds: $secs,
      cites_ok: $ok, cites_bad: $bad, worker_tokens_in: $tin, worker_tokens_out: $tout}')"
}

# ------------------------------------------------------------------- run

small_output() {
  local f="$1" lines bytes
  lines=$(co_file_lines "$f"); bytes=$(co_file_bytes "$f")
  [ "$lines" -le "$(co_cfg_int '.digest.threshold_lines' 150)" ] && [ "$bytes" -le "$(co_cfg_int '.digest.threshold_bytes' 12000)" ]
}

cmd_run() {
  local focus="" model="" shcmd="" no_model=false
  local -a argv
  argv=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -q|--focus|--question) need "$@"; focus="$2"; shift 2 ;;
      -m|--model) need "$@"; model="$2"; shift 2 ;;
      -c) need "$@"; shcmd="$2"; shift 2 ;;
      --no-model) no_model=true; shift ;;
      -h|--help) usage; exit 0 ;;
      --) shift; while [ $# -gt 0 ]; do argv+=("$1"); shift; done ;;
      *) while [ $# -gt 0 ]; do argv+=("$1"); shift; done ;;
    esac
  done
  local label a
  if [ -n "$shcmd" ]; then label="$shcmd"
  elif [ ${#argv[@]} -gt 0 ]; then
    label=""
    for a in "${argv[@]}"; do label="$label${label:+ }$(co_shquote "$a")"; done
  else die "run: nothing to run. Usage: offload run [-q FOCUS] -- CMD ARGS...  or  offload run -c 'CMD'"
  fi

  local log rc
  log=$(co_new_log "$label")
  if [ -n "$shcmd" ]; then bash -c "$shcmd" > "$log" 2>&1; rc=$?
  else "${argv[@]}" > "$log" 2>&1; rc=$?
  fi

  if small_output "$log"; then
    cat "$log"; rm -f "$log"
    exit "$rc"
  fi
  $no_model && export OFFLOAD_NO_MODEL=1
  OFFLOAD_MODEL_OVERRIDE="$model" co_digest "$log" "$label" "$rc" "$focus" run
  exit "$rc"
}

cmd_summarize() {
  local focus="" model="" label="" file="" no_model=false
  while [ $# -gt 0 ]; do
    case "$1" in
      -q|--focus|--question) need "$@"; focus="$2"; shift 2 ;;
      -m|--model) need "$@"; model="$2"; shift 2 ;;
      --label) need "$@"; label="$2"; shift 2 ;;
      --no-model) no_model=true; shift ;;
      -h|--help) usage; exit 0 ;;
      -) file="-"; shift ;;
      -*) die "summarize: unknown option $1" ;;
      *) file="$1"; shift ;;
    esac
  done
  local log
  log=$(co_new_log "${label:-${file:-stdin}}")
  if [ -n "$file" ] && [ "$file" != "-" ]; then
    [ -f "$file" ] || die "summarize: no such file: $file"
    if co_is_secret_target "$file"; then die "summarize: refusing to send $file (matches privacy.secret_globs)" "$CO_E_REFUSED"; fi
    cp "$file" "$log"
  else
    if [ -t 0 ]; then die "summarize: pipe text in or give a FILE"; fi
    cat > "$log"
  fi
  if small_output "$log"; then cat "$log"; rm -f "$log"; exit 0; fi
  $no_model && export OFFLOAD_NO_MODEL=1
  OFFLOAD_MODEL_OVERRIDE="$model" co_digest "$log" "${label:-${file:-stdin}}" "" "$focus" summarize
}

# ----------------------------------------------------------------- write

# Removes one wrapping ``` fence (models add them despite instructions) but
# leaves fences inside the content alone, so Markdown output survives.
strip_wrapping_fence() {
  awk '{ l[NR] = $0 }
    END {
      s = 1; e = NR
      while (s <= e && l[s] ~ /^[ \t]*$/) s++
      while (e >= s && l[e] ~ /^[ \t]*$/) e--
      if (s < e && l[s] ~ /^[ \t]*```/ && l[e] ~ /^[ \t]*```[ \t]*$/) { s++; e-- }
      for (i = s; i <= e; i++) print l[i]
    }' "$1"
}

cmd_write() {
  local spec="" out="" model="" force=false check="" allow_secrets=false check_failed=false
  local -a refs ctxs
  refs=(); ctxs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --spec|-s) need "$@"; spec="$2"; shift 2 ;;
      --ref|--reference|-r) need "$@"; refs+=("$2"); shift 2 ;;
      --context|-x) need "$@"; ctxs+=("$2"); shift 2 ;;
      --out|--target|-o) need "$@"; out="$2"; shift 2 ;;
      -m|--model) need "$@"; model="$2"; shift 2 ;;
      --force) force=true; shift ;;
      --check) need "$@"; check="$2"; shift 2 ;;
      --allow-secrets) allow_secrets=true; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "write: unexpected argument $1 (see offload help)" ;;
    esac
  done
  [ -n "$spec" ] || die 'write: --spec "WHAT TO GENERATE" is required'
  [ ${#refs[@]} -gt 0 ] || die "write: --ref FILE is required — an existing file whose patterns the output must follow. For a follow-up, reference the file the previous call generated."
  if [ -n "$out" ] && [ -e "$out" ] && ! $force; then
    die "write: $out already exists — pick a new --out, or add --force to overwrite it"
  fi

  local f prompt answer
  co_tmp prompt; co_tmp answer
  for f in "${refs[@]}" ${ctxs[@]+"${ctxs[@]}"}; do
    [ -f "$f" ] || die "write: file not found: $f"
    if co_is_secret_target "$f" && ! $allow_secrets; then die "write: refusing to send $f (matches privacy.secret_globs)" "$CO_E_REFUSED"; fi
  done
  {
    for f in "${refs[@]}"; do printf '<reference path="%s">\n' "$f"; co_redact < "$f"; printf '</reference>\n\n'; done
    for f in ${ctxs[@]+"${ctxs[@]}"}; do printf '<context path="%s">\n' "$f"; co_redact < "$f"; printf '</context>\n\n'; done
    [ -n "$out" ] && printf '<target path="%s"/>\n' "$out"
    printf '<spec>%s</spec>\n' "$spec"
  } > "$prompt"

  local t0 rc
  t0=$(co_now)
  co_oc_invoke write "$prompt" "$(co_work_dir)" "$answer" "$model"; rc=$?
  if [ "$rc" != 0 ]; then report_failure "write" "$rc"; exit "$rc"; fi
  strip_wrapping_fence "$answer" > "$answer.c" && mv "$answer.c" "$answer"

  local n todos
  n=$(co_file_lines "$answer")
  todos=$(grep -c 'TODO(offload)' "$answer" 2>/dev/null || true)
  if [ -z "$out" ]; then
    cat "$answer"
    footer "write · $CO_OC_MODEL · $n lines · $(co_elapsed "$t0")s · review before use"
  else
    mkdir -p "$(dirname "$out")" 2>/dev/null
    cp "$answer" "$out" || die "write: could not write $out" "$CO_E_WORKER"
    echo "offload write: wrote $n lines to $out ($CO_OC_MODEL, $(co_elapsed "$t0")s)."
    [ "${todos:-0}" -gt 0 ] && echo "  $todos TODO(offload) marker(s) where the worker lacked information — grep -n 'TODO(offload)' $(co_shquote "$out")"
    echo "  Review it: Read the file (or the parts that need judgment) and fix what the worker got wrong."
    if [ -n "$check" ]; then
      local log crc
      log=$(co_new_log "check-$check")
      bash -c "$check" > "$log" 2>&1; crc=$?
      if [ "$crc" = 0 ]; then echo "  check passed: $check"; else echo "  check FAILED (exit $crc): $check"; check_failed=true; fi
      if small_output "$log"; then sed 's/^/    /' "$log"; rm -f "$log"
      else OFFLOAD_MODEL_OVERRIDE="" co_digest "$log" "$check" "$crc" "" run | sed 's/^/    /'
      fi
    fi
  fi
  co_stats_append "$(jq -nc --arg model "$CO_OC_MODEL" --argjson lines "$n" --argjson secs "$(co_elapsed "$t0")" \
    --argjson bytes "$(co_file_bytes "$answer")" --arg out "$out" \
    --argjson tin "${CO_OC_TOKENS_IN:-0}" --argjson tout "${CO_OC_TOKENS_OUT:-0}" \
    '{ts: now | floor, kind: "write", model: $model, lines: $lines, seconds: $secs,
      saved_tokens: (if $out == "" then 0 else ($bytes / 4 | floor) end), worker_tokens_in: $tin, worker_tokens_out: $tout}')"
  # The file is written either way; exit 1 tells Claude the check failed.
  $check_failed && exit 1
  return 0
}

# ------------------------------------------------------------------- ask

cmd_ask() {
  local question="" model="" use_stdin=false file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -m|--model) need "$@"; model="$2"; shift 2 ;;
      --stdin) use_stdin=true; shift ;;
      -f|--file) need "$@"; file="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      --) shift; question="$question${question:+ }$*"; break ;;
      -*) die "ask: unknown option $1" ;;
      *) question="$question${question:+ }$1"; shift ;;
    esac
  done
  [ -n "$question" ] || die "ask: give a question"
  local prompt answer rc t0
  co_tmp prompt; co_tmp answer
  {
    if $use_stdin; then printf '<input>\n'; co_redact | co_fence; printf '</input>\n\n'; fi
    if [ -n "$file" ]; then
      [ -f "$file" ] || die "ask: no such file: $file"
      co_is_secret_target "$file" && die "ask: refusing to send $file (matches privacy.secret_globs)" "$CO_E_REFUSED"
      printf '<input path="%s">\n' "$file"; co_redact < "$file" | co_fence; printf '</input>\n\n'
    fi
    printf '%s\n' "$question"
  } > "$prompt"
  t0=$(co_now)
  co_oc_invoke ask "$prompt" "$(co_work_dir)" "$answer" "$model"; rc=$?
  if [ "$rc" != 0 ]; then report_failure "ask" "$rc"; exit "$rc"; fi
  cat "$answer"
  footer "${CO_CMD_LABEL:-ask} · $CO_OC_MODEL · $(co_elapsed "$t0")s"
  co_stats_append "$(jq -nc --arg model "$CO_OC_MODEL" --argjson secs "$(co_elapsed "$t0")" \
    --argjson tin "${CO_OC_TOKENS_IN:-0}" --argjson tout "${CO_OC_TOKENS_OUT:-0}" \
    '{ts: now | floor, kind: "ask"} + (if env.CO_TASK_NAME then {task: env.CO_TASK_NAME} else {} end) + {model: $model, seconds: $secs, saved_tokens: 0, worker_tokens_in: $tin, worker_tokens_out: $tout}')"
}

# ----------------------------------------------------------------- tasks

# Custom tasks: tasks.<name> = {description, prompt | prompt_file, model, tools}
# in the config. A task runs through the read flow (with files), the ask flow
# (no files) or the explore flow (tools: "read"), with its own instructions.
co_task_names() { co_cfg_list '(.tasks // {}) | keys'; }

# Prints the task's instructions; a prompt_file must be a regular, non-secret
# file of at most 64 KB inside the project or the user config directory.
co_task_prompt() {
  local name="$1" p f real root confdir size
  p=$(co_cfg ".tasks[\"$name\"].prompt")
  f=$(co_cfg ".tasks[\"$name\"].prompt_file")
  if [ -n "$f" ]; then
    case "$f" in \~/*) f="$HOME/${f#\~/}" ;; /*) ;; *) f="$(co_project_dir)/$f" ;; esac
    [ -f "$f" ] || { co_err "task $name: prompt_file not found: $f"; return 1; }
    real=$(co_real_path "$f")
    root=$(cd -P "$(co_project_dir)" 2>/dev/null && pwd)
    confdir=$(cd -P "$(dirname "$(co_user_config_path)")" 2>/dev/null && pwd || echo /nonexistent)
    case "$real" in
      "$root"/*|"$confdir"/*) ;;
      *) co_err "task $name: prompt_file must be inside the project or $(dirname "$(co_user_config_path)")"; return 1 ;;
    esac
    co_is_secret_target "$real" && { co_err "task $name: prompt_file matches privacy.secret_globs"; return 1; }
    size=$(co_file_bytes "$real")
    [ "$size" -le 65536 ] || { co_err "task $name: prompt_file is over 64 KB"; return 1; }
    cat "$real"
    return 0
  fi
  [ -n "$p" ] || { co_err "task $name: give it a prompt or a prompt_file"; return 1; }
  printf '%s\n' "$p"
}

# offload tasks templates | offload tasks add NAME [--from TEMPLATE] [--project]
# Twin: cmdTasks in core.ts (same text).
cmd_tasks_templates() {
  echo "Task templates (offload tasks add NAME --from TEMPLATE):"
  jq -r 'to_entries[] | select(.key | startswith("_") | not) | "  \(.key)\(" " * (20 - (.key | length)))\(.value.description)\n  \(" " * 20)e.g. \(.value.usage)"' "$CO_ROOT/config/task-templates.json"
}
cmd_tasks_add() {
  local name="" from="" project=false target cur
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) need "$@"; from="$2"; shift 2 ;;
      --project) project=true; shift ;;
      -*) die "tasks add: unknown option $1" ;;
      *) name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "tasks add NAME [--from TEMPLATE] [--project]   (templates: offload tasks templates)"
  [ -n "$from" ] || from="$name"
  printf '%s' "$name" | LC_ALL=C grep -Eq '^[a-z0-9_][a-z0-9_-]{0,39}$' || die "tasks add: a task name is lowercase letters, digits, - and _ (up to 40)"
  jq -e --arg t "$from" '.[$t] | type == "object"' "$CO_ROOT/config/task-templates.json" >/dev/null 2>&1 ||
    die "tasks add: no template \"$from\" (offload tasks templates lists them)"
  if $project; then target=$(co_project_config_path); else target=$(co_user_config_path); fi
  mkdir -p "$(dirname "$target")"
  cur='{}'; [ -f "$target" ] && cur=$(cat "$target")
  printf '%s' "$cur" | jq -e 'type == "object"' >/dev/null 2>&1 || die "tasks add: $target is not valid JSON; fix it first"
  printf '%s' "$cur" | jq -e --arg n "$name" '.tasks[$n] != null' >/dev/null 2>&1 && die "tasks add: $name already exists in $target"
  (umask 077; printf '%s' "$cur" | jq --arg n "$name" --slurpfile t "$CO_ROOT/config/task-templates.json" --arg f "$from" \
    '.tasks[$n] = ($t[0][$f] | {description, prompt, tools})' > "$target.tmp") && mv "$target.tmp" "$target"
  echo "added task $name (from $from) to $target"
  echo "run it: $(jq -r --arg f "$from" --arg n "$name" '.[$f].usage | sub("task " + $f; "task " + $n)' "$CO_ROOT/config/task-templates.json")"
}

cmd_tasks() {
  case "${1:-}" in
    templates) cmd_tasks_templates; return ;;
    add) shift; cmd_tasks_add "$@"; return ;;
  esac
  local names n
  names=$(co_task_names)
  if [ -z "$names" ]; then
    echo "No custom tasks yet. Start from a template (offload tasks templates), for example:"
    echo "  offload tasks add review-diff"
    echo "or write your own:"
    echo '  offload config set tasks.review-sql '"'"'{"description":"Find N+1 queries","prompt":"You review SQL access code for N+1 queries.","tools":"none"}'"'"
    echo "then: offload task review-sql src/db/"
    return 0
  fi
  echo "Custom tasks (offload task NAME [-q QUESTION] [PATH...]):"
  while IFS= read -r n; do
    [ -z "$n" ] && continue
    printf '  %-20s %s  [%s · %s]\n' "$n" "$(co_cfg ".tasks[\"$n\"].description" "")" \
      "$(co_cfg ".tasks[\"$n\"].tools" none)" "$(co_cfg ".tasks[\"$n\"].model" "default model")"
  done <<EOF
$names
EOF
}

cmd_task() {
  local name="${1:-}"
  case "$name" in ''|--list|-l) cmd_tasks; return 0 ;; -h|--help) usage; return 0 ;; esac
  shift
  case "$name" in *[!a-z0-9_-]*|-*) die "task: names use lowercase letters, digits, - and _ ($name)" ;; esac
  [ ${#name} -le 40 ] || die "task: names are at most 40 characters ($name)"
  [ -n "$(co_cfg ".tasks[\"$name\"]")" ] || die "task: no task named $name (offload tasks lists them)"
  local tools question="" model="" use_stdin=false
  local -a paths=()
  tools=$(co_cfg ".tasks[\"$name\"].tools" none)
  case "$tools" in none|read) ;; *) die "task $name: tools must be \"none\" or \"read\" (got $tools)" ;; esac
  while [ $# -gt 0 ]; do
    case "$1" in
      -q|--question) need "$@"; question="$2"; shift 2 ;;
      -m|--model) need "$@"; model="$2"; shift 2 ;;
      --stdin) use_stdin=true; shift ;;
      --) shift; while [ $# -gt 0 ]; do paths+=("$1"); shift; done ;;
      -*) die "task: unknown option $1" ;;
      *) paths+=("$1"); shift ;;
    esac
  done
  local sysf
  co_tmp sysf
  { co_task_prompt "$name" || exit "$CO_E_USAGE"; printf '\n'; cat "$CO_ROOT/prompts/task-contract.md"; } > "$sysf"
  export CO_TASK_SYSTEM_FILE="$sysf" CO_TASK_NAME="$name" CO_CMD_LABEL="task $name"
  CO_TASK_MODEL=$(co_cfg ".tasks[\"$name\"].model")
  export CO_TASK_MODEL
  [ -z "$question" ] && question="Do the task described in your instructions."
  local -a margs=()
  [ -n "$model" ] && margs=(-m "$model")
  if [ "$tools" = read ]; then
    [ ${#paths[@]} -gt 0 ] && question="$question (start with: ${paths[*]})"
    cmd_explore "${margs[@]}" -- "$question"
  elif [ ${#paths[@]} -gt 0 ]; then
    cmd_read "${margs[@]}" -q "$question" -- "${paths[@]}"
  elif $use_stdin; then
    cmd_ask "${margs[@]}" --stdin -- "$question"
  else
    cmd_ask "${margs[@]}" -- "$question"
  fi
}

# ----------------------------------------------------------------- model

CO_MODEL_SLOTS="default read summarize explore write ask fallback"

co_known_backends() {
  printf 'opencode %s ' "$CO_AGENT_BACKENDS"
  { jq -r '.endpoints | keys[]' "$CO_ROOT/config/connectors.json"; co_cfg_list '(.endpoints // {}) | keys'; } 2>/dev/null | awk '!seen[$0]++' | tr '\n' ' '
}

# Closest known backend within two edits, for "did you mean".
co_did_you_mean() {
  co_known_backends | tr ' ' '\n' | LC_ALL=C awk -v w="$1" '
    function lev(a, b,   i, j, la, lb, d, c) {
      la = length(a); lb = length(b)
      for (i = 0; i <= la; i++) d[i, 0] = i
      for (j = 0; j <= lb; j++) d[0, j] = j
      for (i = 1; i <= la; i++) for (j = 1; j <= lb; j++) {
        c = (substr(a, i, 1) == substr(b, j, 1)) ? 0 : 1
        d[i, j] = d[i-1, j] + 1
        if (d[i, j-1] + 1 < d[i, j]) d[i, j] = d[i, j-1] + 1
        if (d[i-1, j-1] + c < d[i, j]) d[i, j] = d[i-1, j-1] + c
      }
      return d[la, lb]
    }
    NF { s = lev(w, $0); if (best == "" || s < bs) { best = $0; bs = s } }
    END { if (best != "" && bs <= 2) print best }'
}

# co_ref_check REF — validates a model reference without calling a model.
# Sets CO_REF_NOTE (where it runs, plus a warning if it cannot run here) and
# returns 0, or sets CO_REF_ERR and returns 1. Twin: refCheck in model.ts.
co_ref_check() {
  local ref="$1" backend model def prefix ep label envk key bin m h near
  CO_REF_NOTE="" CO_REF_ERR=""
  def=$(co_cfg '.backend' opencode)
  case "$ref" in
    @host|@self)
      if h=$(co_detect_host) && m=$(co_host_model); then CO_REF_NOTE="$m via $h's own plan"
      else CO_REF_NOTE="your harness's own model (resolved when a harness calls offload)"; fi
      return 0 ;;
    @host-api)
      local ep n
      if ! h=$(co_detect_host); then CO_REF_NOTE="your harness's model through an API key (resolved when a harness calls offload)"; return 0; fi
      m=$(co_host_api_model)
      case "$m" in ''|@*) CO_REF_NOTE="$h has no API-key backup; this entry is skipped"; return 0 ;; esac
      n=${m%%:*}; ep=$(co_endpoint_json "$n")
      CO_REF_NOTE="$m via $h's API key"
      if [ -n "$ep" ] && [ -z "$(co_endpoint_key "$n" "$ep")" ]; then
        case "$(printf '%s' "$ep" | jq -r .base_url)" in *127.0.0.1*|*localhost*) ;; *) CO_REF_NOTE="$CO_REF_NOTE; warning: no key yet (offload key $n)" ;; esac
      fi
      return 0 ;;
    @default) CO_REF_NOTE="$def's default model"; return 0 ;;
    '') CO_REF_ERR="give a model reference, e.g. groq:llama-3.3-70b, claude:haiku or @host"; return 1 ;;
  esac
  backend="$def" model="$ref"
  prefix=${ref%%:*}
  case "$prefix" in
    "$ref"|*/*) ;;
    *)
      if [ "$prefix" = opencode ] || co_is_agent_backend "$prefix" || [ -n "$(co_endpoint_json "$prefix")" ]; then
        backend="$prefix" model="${ref#*:}"
      else
        near=$(co_did_you_mean "$prefix")
        CO_REF_ERR="unknown backend \"$prefix\" in $ref${near:+ — did you mean $near:${ref#*:}?} (backends: $(co_known_backends | sed 's/ $//; s/ /, /g'))"
        return 1
      fi ;;
  esac
  if [ "$backend" = opencode ]; then
    case "$model" in
      ''|*/*) ;;
      *) if co_is_agent_backend "$model" || [ -n "$(co_endpoint_json "$model")" ]; then
           CO_REF_ERR="\"$model\" is a backend — write $model:MODEL (offload models $model lists them)"
         else
           CO_REF_ERR="\"$ref\" is not a model reference — write BACKEND:MODEL (e.g. openrouter:qwen/qwen3-coder), provider/model for OpenCode, or @host"
         fi
         return 1 ;;
    esac
    CO_REF_NOTE="OpenCode"
    co_have_opencode || CO_REF_NOTE="$CO_REF_NOTE; warning: opencode is not installed"
    return 0
  fi
  if co_is_agent_backend "$backend"; then
    bin=$(co_agent_bin "$backend")
    CO_REF_NOTE="$backend CLI"
    [ -z "$model" ] && CO_REF_NOTE="$backend CLI, its default model"
    command -v "$bin" >/dev/null 2>&1 || CO_REF_NOTE="$CO_REF_NOTE; warning: $bin is not installed"
    return 0
  fi
  ep=$(co_endpoint_json "$backend")
  [ -n "$model" ] || { CO_REF_ERR="$backend needs a model id, e.g. $backend:MODEL (offload models $backend lists them)"; return 1; }
  label=$(printf '%s' "$ep" | jq -r '.label // empty')
  CO_REF_NOTE="${label:-$backend}"
  envk=$(printf '%s' "$ep" | jq -r '.api_key_env // empty')
  key=$(co_endpoint_key "$backend" "$ep")
  if [ -z "$key" ] && [ -n "$envk" ]; then
    CO_REF_NOTE="$CO_REF_NOTE; warning: no API key (export $envk or run offload setup)"
  fi
  return 0
}

co_model_slot_key() {
  case " $CO_MODEL_SLOTS " in *" $1 "*) printf 'models.%s' "$1"; return 0 ;; esac
  case "$1" in *[!a-z0-9_-]*|-*|'') return 1 ;; esac
  [ -n "$(co_cfg ".tasks[\"$1\"]")" ] && { printf 'tasks.%s.model' "$1"; return 0; }
  return 1
}

co_model_line() {
  local slot="$1" key="$2" v
  case "$key" in tasks.*) slot="task $slot" ;; esac
  if [ "$slot" = fallback ]; then
    v=$(co_cfg_list '.models.fallback // []' | tr '\n' ' ' | sed 's/ $//; s/ /, /g')
    printf '  %-18s %s\n' "$slot" "${v:-(none)}"
    return 0
  fi
  v=$(co_cfg "getpath(\"$key\" | split(\".\"))")
  if [ -z "$v" ]; then
    [ "$slot" = default ] || { printf '  %-18s (default)\n' "$slot"; return 0; }
    v=@default
  fi
  if co_ref_check "$v"; then printf '  %-18s %s — %s\n' "$slot" "$v" "$CO_REF_NOTE"
  else printf '  %-18s %s — error: %s\n' "$slot" "$v" "$CO_REF_ERR"; fi
}

co_model_bad_slot() {
  local w="$1" kind=""
  if [ "$w" = opencode ] || co_is_agent_backend "$w"; then kind=agent
  elif [ -n "$(co_endpoint_json "$w")" ]; then kind=http; fi
  case "$kind" in
    agent) die "model: \"$w\" is a backend — write $w: for its default model or $w:MODEL" ;;
    http) die "model: \"$w\" is a backend — write $w:MODEL (offload models $w lists them)" ;;
  esac
  die "model: \"$w\" is neither a task (default, read, summarize, explore, write, ask, fallback, or one of offload tasks) nor a model reference (BACKEND:MODEL, provider/model, @host)"
}

cmd_model() {
  local target project=false reset=false s n slot="" key=""
  local -a args=() refs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project=true; shift ;;
      --reset) reset=true; shift ;;
      -h|--help) usage; return 0 ;;
      --) shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
      -*) die "model: unknown option $1" ;;
      *) args+=("$1"); shift ;;
    esac
  done
  target=$(co_user_config_path)
  $project && target=$(co_project_config_path)
  if [ ${#args[@]} -gt 0 ]; then
    if key=$(co_model_slot_key "${args[0]}"); then
      slot="${args[0]}"
      [ ${#args[@]} -gt 1 ] && refs=("${args[@]:1}")
    else
      case "${args[0]}" in
        *[:/@]*) [ ${#args[@]} -eq 1 ] && ! $reset || co_model_bad_slot "${args[0]}"
                 slot=default key=models.default refs=("${args[0]}") ;;
        *) co_model_bad_slot "${args[0]}" ;;
      esac
    fi
  fi
  if $reset; then
    [ ${#refs[@]} -eq 0 ] || die "model: --reset takes no model"
    [ -z "$slot" ] && slot=default key=models.default
    if [ -f "$target" ]; then
      jq -e 'type == "object"' "$target" >/dev/null 2>&1 || die "model: $target is not valid JSON; fix it first"
      (umask 077; jq --arg k "$key" 'delpaths([$k | split(".")])' "$target" > "$target.tmp") && mv "$target.tmp" "$target"
    fi
    CO_CONFIG=""
    echo "✓ $key reset in $target"
    co_model_line "$slot" "$key"
    return 0
  fi
  if [ ${#refs[@]} -eq 0 ]; then
    if [ -n "$slot" ]; then co_model_line "$slot" "$key"; return 0; fi
    echo "Models (change: offload model [TASK] REF · undo: offload model [TASK] --reset · --project for this repo):"
    for s in $CO_MODEL_SLOTS; do co_model_line "$s" "models.$s"; done
    while IFS= read -r n; do
      [ -n "$n" ] && co_model_line "$n" "tasks.$n.model"
    done <<EOT
$(co_task_names)
EOT
    echo "References: @host (your harness's own plan) · BACKEND:MODEL · provider/model (OpenCode). List models: offload models BACKEND"
    return 0
  fi
  [ "$slot" = fallback ] || [ ${#refs[@]} -eq 1 ] || die "model: give one model (only fallback takes several)"
  local r notes="" val cur eff
  for r in "${refs[@]}"; do
    co_ref_check "$r" || die "model: $CO_REF_ERR (to store it anyway: offload config set $key VALUE)"
    notes="$notes  $r — $CO_REF_NOTE"$'\n'
  done
  if [ "$slot" = fallback ]; then val=$(printf '%s\n' "${refs[@]}" | jq -R . | jq -cs .); else val=$(jq -cn --arg v "${refs[0]}" '$v'); fi
  mkdir -p "$(dirname "$target")"
  cur='{}'; [ -f "$target" ] && cur=$(cat "$target")
  printf '%s' "$cur" | jq -e 'type == "object"' >/dev/null 2>&1 || die "model: $target is not valid JSON; fix it first"
  (umask 077; printf '%s' "$cur" | jq --arg k "$key" --argjson v "$val" 'setpath($k | split("."); $v)' > "$target.tmp") && mv "$target.tmp" "$target"
  CO_CONFIG=""
  printf '✓ %s = %s\n' "$key" "$(printf '%s' "$val" | jq -r 'if type == "array" then join(", ") else . end')"
  printf '%s' "$notes"
  echo "  saved in $target · try it: offload doctor --ping"
  eff=$(co_cfg "getpath(\"$key\" | split(\".\")) | tojson")
  [ "$eff" = "$val" ] || echo "  note: another config file overrides this (in effect: $(printf '%s' "$eff" | jq -r 'if type == "array" then join(", ") else . end')); use --project to change this repo's setting"
}

# ------------------------------------------------------------------- key

# offload key [NAME] [--remove] — API keys in the credentials file (mode 600),
# read hidden from the terminal or from stdin; never printed. Twin: key.ts.
cmd_key() {
  local remove=false a name="" f cur key ep env state n hosts
  local -a args=()
  for a in "$@"; do
    case "$a" in
      --remove) remove=true ;;
      -h|--help) usage; return 0 ;;
      -*) die "key: unknown option $a" ;;
      *) args+=("$a") ;;
    esac
  done
  f=$(co_credentials_path)
  cur='{}'
  if [ -f "$f" ]; then
    jq -e 'type == "object"' "$f" >/dev/null 2>&1 || die "$f is not valid JSON; fix it first"
    cur=$(cat "$f")
  fi
  if [ ${#args[@]} -eq 0 ]; then
    echo "API keys (add: offload key NAME · remove: offload key NAME --remove · keys are never shown):"
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      ep=$(co_endpoint_json "$n"); [ -n "$ep" ] || continue
      env=$(printf '%s' "$ep" | jq -r '.api_key_env // empty')
      case "$env" in ''|[!A-Za-z_]*|*[!A-Za-z0-9_]*) env="" ;; esac
      if [ -n "$(printf '%s' "$cur" | jq -r --arg n "$n" '.[$n] // empty')" ]; then state=stored
      elif [ -n "$(printf '%s' "$ep" | jq -r '.api_key // empty')" ]; then state="in config"
      elif [ -n "$env" ] && [ -n "$(eval "printf '%s' \"\${$env:-}\"")" ]; then state="from \$$env"
      else case "$(printf '%s' "$ep" | jq -r .base_url)" in *127.0.0.1*|*localhost*) state="local, no key needed" ;; *) state="not set" ;; esac
      fi
      printf '  %-12s %-22s %s\n' "$n" "$state" "$env"
    done <<EOT
$({ jq -r '.endpoints | keys[]' "$CO_ROOT/config/connectors.json"; co_cfg_list '(.endpoints // {}) | keys'; } 2>/dev/null | awk '!s[$0]++')
EOT
    echo "File: $f"
    return 0
  fi
  [ ${#args[@]} -eq 1 ] || die "key: give the key on the prompt or through stdin, not as an argument (it would stay in your shell history)"
  name="${args[0]}"
  case "$name" in *[!A-Za-z0-9_-]*|-*) die "key: backend names use letters, digits, - and _ ($name)" ;; esac
  ep=$(co_endpoint_json "$name")
  [ -n "$ep" ] || die "key: unknown backend \"$name\" (offload key lists them; add your own with endpoints.$name)"
  if $remove; then
    if [ -z "$(printf '%s' "$cur" | jq -r --arg n "$name" '.[$n] // empty')" ]; then echo "no stored key for $name"; return 0; fi
    (umask 077; printf '%s' "$cur" | jq --arg n "$name" 'del(.[$n])' > "$f.tmp") && mv "$f.tmp" "$f"
    echo "✓ removed the $name key from $f"
    return 0
  fi
  if [ -t 0 ]; then
    printf 'API key for %s: ' "$(printf '%s' "$ep" | jq -r --arg n "$name" '.label // $n')" >&2
    IFS= read -rs key; echo >&2
  else
    IFS= read -r key || true
  fi
  key=$(printf '%s' "$key" | LC_ALL=C sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  [ -n "$key" ] || die "key: empty key, nothing saved"
  case "$key" in *[[:space:]]*) die "key: the key contains spaces; nothing saved" ;; esac
  mkdir -p "$(dirname "$f")"
  (umask 077; printf '%s' "$cur" | jq --arg n "$name" --arg k "$key" '.[$n] = $k' > "$f.tmp") && mv "$f.tmp" "$f"
  chmod 600 "$f" 2>/dev/null || true
  echo "✓ saved the $name key in $f (only you can read it)"
  hosts=$({ jq -r --arg n "$name:" '.host_api_models | to_entries[] | select(.value | startswith($n)) | .key' "$CO_ROOT/config/connectors.json"
            co_cfg_list "(.host_api_models // {}) | to_entries | map(select(.value | type == \"string\" and startswith(\"$name:\")) | .key)"; } | awk 'NF && !s[$0]++' | tr '\n' ' ' | sed 's/ $//; s/ /, /g')
  [ -n "$hosts" ] && echo "  backup for $hosts: add it to your chain with  offload model fallback @host-api @default"
  echo "  use it directly:  offload model $name:MODEL   (offload models $name lists them)"
  return 0
}

# ---------------------------------------------------------------- doctor

# Checks that opencode accepts offload's injected agents, without a model
# call: V1 has `debug agent`; on V2 a run against a non-existent model fails
# with "Model unavailable" once the agent resolved, "Agent not found" if not.
DOCTOR_DETAIL=""
doctor_agents_load() {
  local bin cfg out sid
  bin=$(co_opencode_bin)
  cfg=$(co_oc_config) || { DOCTOR_DETAIL="jq could not build the config"; return 1; }
  if [ "$(co_oc_major)" -ge 2 ]; then
    out=$(cd "$(co_work_dir)" && printf 'ping\n' | OPENCODE_CONFIG_CONTENT="$cfg" "$bin" run --standalone --format json \
            --agent offload-read --title offload:doctor -m offload-doctor/none 2>&1)
    sid=$(printf '%s' "$out" | grep -o '"sessionID":"ses_[A-Za-z0-9_]*"' | head -1 | sed 's/.*"\(ses_[^"]*\)"/\1/')
    co_oc_forget_session "$sid"
    case "$out" in
      *"Agent not found"*) DOCTOR_DETAIL="agent not found"; return 1 ;;
      *no-route*|*"Model unavailable"*) return 0 ;;
      *) DOCTOR_DETAIL=$(printf '%s' "$out" | tail -c 300); return 1 ;;
    esac
  fi
  if OPENCODE_CONFIG_CONTENT="$cfg" "$bin" debug agent offload-read >/dev/null 2>&1; then return 0; fi
  DOCTOR_DETAIL="try: OPENCODE_CONFIG_CONTENT=… $bin debug agent offload-read"
  return 1
}

cmd_doctor() {
  local ping=false reset=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --ping) ping=true; shift ;;
      --reset) reset=true; shift ;;
      *) die "doctor: unknown option $1" ;;
    esac
  done
  local ok="✓" bad="✗" warn="!" problems=0
  echo "offload $CO_VERSION — $CO_ROOT"
  echo "  $ok bash $BASH_VERSION"
  if command -v jq >/dev/null 2>&1; then echo "  $ok jq $(jq --version 2>/dev/null)"
  else echo "  $bad jq missing (brew install jq / apt install jq)"; return 1; fi

  local bin ver
  bin=$(co_opencode_bin)
  if co_have_opencode; then
    ver=$("$bin" --version 2>/dev/null | tail -1)
    echo "  $ok opencode $ver ($(command -v "$bin" 2>/dev/null || echo "$bin"))"
  else
    echo "  - opencode not found as '$bin' (only needed for OpenCode models — https://opencode.ai)"
  fi

  local u p
  u=$(co_user_config_path); p=$(co_project_config_path)
  for f in "$u" "$p"; do
    if [ -f "$f" ]; then
      if jq -e . "$f" >/dev/null 2>&1; then echo "  $ok config $f"; else echo "  $bad config $f is not valid JSON (ignored)"; problems=$((problems + 1)); fi
      # a mistyped key is silently ignored by everything else: say so here
      co_config_unknown "$f" | while IFS="$(printf '\t')" read -r k s; do
        echo "  $warn unknown key $k${s:+ (did you mean $s?)} — ignored"
      done
    else
      echo "  - config $f (not present)"
    fi
  done
  local ign; ign=$(co_project_config_ignored)
  [ -n "$ign" ] && echo "  $warn project config keys ignored (untrusted repo): $ign — \`offload config trust\` if this repo is yours"
  co_cfg_bool '.enabled' true || echo "  $warn offload is disabled (enabled=false or OFFLOAD_DISABLE=1): hooks pass everything through"

  rm -f "$(co_state_dir)/opencode-version" 2>/dev/null; CO_OC_MAJOR=""   # doctor always re-detects
  if $reset; then rm -f "$(co_state_dir)"/cooldowns/* 2>/dev/null; echo "  $ok cooldowns cleared"; fi

  local models_list="" task m cool cli
  if co_have_opencode; then models_list=$("$bin" models 2>/dev/null); fi
  echo "  models (task → chain):"
  for task in read explore summarize write ask; do
    printf '    %-9s → %s\n' "$task" "$(co_model_chain "$task" | tr '\n' ' ')"
  done
  local all_models tn terr ttools tmodel tmodels=""
  tn=$(co_task_names)
  if [ -n "$tn" ]; then
    echo "  your tasks:"
    while IFS= read -r task; do
      [ -z "$task" ] && continue
      ttools=$(co_cfg ".tasks[\"$task\"].tools" none)
      tmodel=$(co_cfg ".tasks[\"$task\"].model")
      case "$task" in *[!a-z0-9_-]*|-*) echo "    $bad $task: names use lowercase letters, digits, - and _"; problems=$((problems + 1)); continue ;; esac
      if ! terr=$(co_task_prompt "$task" 2>&1 >/dev/null); then
        echo "    $bad ${terr#offload: }"; problems=$((problems + 1))
      elif [ "$ttools" != none ] && [ "$ttools" != read ]; then
        echo "    $bad task $task: tools must be \"none\" or \"read\" (got $ttools)"; problems=$((problems + 1))
      elif [ -n "$tmodel" ] && ! co_ref_check "$tmodel"; then
        echo "    $bad task $task: $CO_REF_ERR"; problems=$((problems + 1))
      else
        echo "    $ok task $task ($ttools · ${tmodel:-default model})"
        [ -n "$tmodel" ] && tmodels="$tmodels$tmodel"$'\n'
      fi
    done <<EOF
$tn
EOF
  fi
  all_models=$({ for task in read explore summarize write ask; do co_model_chain "$task"; done
                 printf '%s' "$tmodels"; } | awk 'NF && !s[$0]++')
  local host hm label ep uses_oc=false
  if host=$(co_detect_host); then
    hm=$(co_host_model 2>/dev/null)
    echo "  $ok @host = the calling harness's own plan: $host → ${hm:-?}"
  else
    echo "  - @host = the calling harness's own plan (no harness detected here; hooks and MCP set OFFLOAD_HOST)"
  fi
  while IFS= read -r m; do
    [ -z "$m" ] && continue
    if ! co_ref_check "$m"; then echo "  $bad $m: $CO_REF_ERR"; problems=$((problems + 1)); continue; fi
    if ! co_route "$m" read; then
      case "$m" in @host|@self) echo "  $warn $m: resolved per harness at run time (none detected in this shell)" ;;
        @host-api) echo "  $warn @host-api: backup skipped — ${CO_OC_ERROR#@host-api: }" ;;
        *) echo "  $bad $m: $CO_OC_ERROR"; problems=$((problems + 1)) ;; esac
      continue
    fi
    label="$m"; [ "$CO_RT_REF" != "$m" ] && label="$m → $CO_RT_REF"
    case "$CO_RT_KIND" in
      agent)
        if co_route_ready; then echo "  $ok $label (via $(command -v "$(co_agent_bin "$CO_RT_BACKEND")") — uses its own login/plan)"
        else echo "  $bad $label needs the $(co_agent_bin "$CO_RT_BACKEND") CLI on PATH (or agents.$CO_RT_BACKEND.bin)"; problems=$((problems + 1)); fi ;;
      http)
        ep=$(co_endpoint_json "$CO_RT_BACKEND")
        if [ -n "$(co_endpoint_key "$CO_RT_BACKEND" "$ep")" ] || printf '%s' "$ep" | grep -q '127.0.0.1\|localhost'; then echo "  $ok $label (HTTP $(printf '%s' "$ep" | jq -r .base_url))"
        else echo "  $bad $label: no API key (set $(printf '%s' "$ep" | jq -r '.api_key_env // "one"') or run: offload setup)"; problems=$((problems + 1)); fi ;;
      ts)
        if cli=$(co_ts_cli); then echo "  $ok $label (via $cli)"; else echo "  $bad $label needs Node.js 18+ or the harness-offload CLI: npm i -g harness-offload"; problems=$((problems + 1)); fi ;;
      *)
        uses_oc=true
        if [ -z "$CO_RT_MODEL" ] && [ "$(co_model_chain read | head -n 1)" = "@default" ]; then
          echo "  $warn @default = OpenCode's own default model. Pin a cheap one: offload config set models.default PROVIDER/MODEL (or @host)"
        elif [ -z "$CO_RT_MODEL" ]; then
          if co_have_opencode; then echo "  $ok @default = OpenCode's own default model (fallback)"; else echo "  - @default (fallback) needs opencode — skipped when absent"; fi
        elif [ -n "$models_list" ] && ! printf '%s\n' "$models_list" | grep -qxF "$CO_RT_MODEL"; then
          echo "  $bad $label is not in \`opencode models\` (typo, or provider not logged in: opencode auth login)"
          problems=$((problems + 1))
        elif [ -n "$models_list" ]; then
          echo "  $ok $label available"
        elif ! co_have_opencode; then
          echo "  $bad $label needs opencode"; problems=$((problems + 1))
        fi ;;
    esac
    if cool=$(co_model_cooling "$CO_RT_REF"); then echo "  $warn $CO_RT_REF cooling down: $cool (offload doctor --reset)"; fi
  done <<EOF
$all_models
EOF

  if $uses_oc && co_have_opencode; then
    if doctor_agents_load; then
      echo "  $ok worker agents load in opencode (v$(co_oc_major))"
    else
      echo "  $bad opencode did not load offload's worker agents (OPENCODE_CONFIG_CONTENT): $DOCTOR_DETAIL"
      problems=$((problems + 1))
    fi
  fi

  if $ping; then
    echo "  live ping:"
    local prompt answer rc
    co_tmp prompt; co_tmp answer
    printf 'Reply with exactly the word: pong\n' > "$prompt"
    while IFS= read -r m; do
      [ -z "$m" ] && continue
      : > "$answer"
      co_oc_attempt offload-ask "$m" "$prompt" "$(co_work_dir)" "" "$answer"
      rc=$?
      if [ "$rc" = 0 ]; then echo "    $ok $m → $(head -c 40 "$answer" | LC_ALL=C tr '\n' ' ') (${CO_OC_SECONDS}s)"
      else echo "    $bad $m → exit $rc: $(printf '%s' "$CO_OC_ERROR" | head -1 | LC_ALL=C cut -c1-160)"; problems=$((problems + 1)); fi
    done <<EOF
$all_models
EOF
  fi

  echo "  state: $(co_state_dir)"
  echo "  hooks: read_guard=$(co_cfg '.hooks.read_guard') (>$(co_cfg '.hooks.read_threshold_lines') lines or >$(co_cfg '.hooks.read_threshold_tokens') tokens) · bash_read_guard=$(co_cfg '.hooks.bash_read_guard') · summarize_bash_output=$(co_cfg '.hooks.summarize_bash_output') · autowrap=$(co_cfg '.hooks.autowrap')"
  if [ "$problems" -gt 0 ]; then echo "$problems problem(s) found."; return 1; fi
  echo "All good."
}

# ----------------------------------------------------------------- stats

# offload explain [N] — what the hooks did lately (blocked reads, replaced outputs), each
# with the rule, its current value and how to change it. Twin: cmdExplain in admin.ts.
cmd_explain() {
  local n=10 f
  case "${1:-}" in ''|*[!0-9]*) ;; *) n=$1 ;; esac
  f="$(co_state_dir)/stats.jsonl"
  if [ ! -s "$f" ]; then
    printf 'Nothing yet: offload'"'"'s hooks have not blocked or replaced anything (%s).\n' "$f"
    return 0
  fi
  jq -rs --argjson n "$n" --arg rl "$(co_cfg '.hooks.read_threshold_lines' 600)" --arg rt "$(co_cfg '.hooks.read_threshold_tokens' 6000)" \
    --arg ch "$(co_cfg '.hooks.read_max_chunk_lines' 600)" --arg bl "$(co_cfg '.hooks.bash_output_threshold_lines' 250)" \
    --arg bb "$(co_cfg '.hooks.bash_output_threshold_bytes' 20000)" --arg f "$f" '
    def fmt: tostring | if length <= 3 then . else (.[:-3] | fmt) + "," + .[-3:] end;
    def kb: (((. // 0) + 1023) / 1024 | floor | tostring) + " KB";
    def file: if (.file // "") == "" then "a file (not recorded)" else .file end;
    def full: "over hooks.read_threshold_lines (\($rl)) or hooks.read_threshold_tokens (\($rt))";
    def out: "over hooks.bash_output_threshold_lines (\($bl)) or hooks.bash_output_threshold_bytes (\($bb))";
    map(select(.kind == "hook" or (.kind == "digest" and ((.source // "") as $s | $s == "hook" or $s == "search" or $s == "diff" or $s == "json" or $s == "repeat"))))
    | if length == 0 then "Nothing yet: offload'"'"'s hooks have not blocked or replaced anything (\($f))." else
      length as $all | reverse | .[:$n] |
      "offload explain — what the hooks did, newest first (\(length) of \($all))",
      (.[] | "  \(.ts | strflocaltime("%m-%d %H:%M"))  " + (
        if .kind == "hook" and .event == "read_blocked" then
          "blocked a full Read of \(file) (\(.lines // 0 | fmt) lines, ~\(.tokens // 0 | fmt) tokens)\n               why: \(full)\n               change: offload config set hooks.read_threshold_lines N · off: offload config set hooks.read_guard off"
        elif .kind == "hook" and .event == "read_slice_blocked" then
          "blocked a Read slice of \(.lines // 0 | fmt) lines of \(file)\n               why: over hooks.read_max_chunk_lines (\($ch))\n               change: offload config set hooks.read_max_chunk_lines N"
        elif .kind == "hook" and .event == "bash_read_blocked" then
          "blocked `\(.prog // "?")` of \(file) (\(.lines // 0 | fmt) lines, ~\(.tokens // 0 | fmt) tokens)\n               why: \(full)\n               change: offload config set hooks.read_threshold_lines N · off: offload config set hooks.bash_read_guard false"
        elif .kind == "hook" and .event == "autowrap" then
          "ran `\(.command // "a command")` through offload run\n               why: hooks.autowrap is on and the command matched hooks.autowrap_pattern\n               off: offload config set hooks.autowrap false"
        elif .kind == "hook" then
          "hook event \(.event // "?")"
        elif .source == "search" then
          "showed a search view of `\(.label // "?")` (\(.bytes_in | kb) → \(.bytes_out | kb))\n               why: a search \(out)\n               all of it: \(.log // "(log not recorded)") · off: offload config set hooks.search_view false"
        elif .source == "diff" then
          "showed a diff view of `\(.label // "?")` (\(.bytes_in | kb) → \(.bytes_out | kb))\n               why: a diff \(out)\n               all of it: \(.log // "(log not recorded)") · off: offload config set hooks.diff_view false"
        elif .source == "json" then
          "showed the JSON structure of `\(.label // "?")` (\(.bytes_in | kb) → \(.bytes_out | kb))\n               why: JSON output \(out)\n               all of it: \(.log // "(log not recorded)") · off: offload config set hooks.json_view false"
        elif .source == "repeat" then
          "said `\(.label // "?")` printed the same output as before (\(.bytes_in | kb))\n               why: the same output again in this session\n               all of it: \(.log // "(log not recorded)")"
        else
          "digested the output of `\(.label // "?")` (\(.bytes_in | kb) → \(.bytes_out | kb))\n               why: \(out)\n               all of it: \(.log // "(log not recorded)") · off: offload config set hooks.summarize_bash_output false"
        end))
      end' "$f"
}

cmd_stats() {
  local days=0 json=false csv=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) need "$@"; days="$2"; shift 2 ;;
      --json) json=true; shift ;;
      --csv) csv=true; shift ;;
      *) die "stats: unknown option $1" ;;
    esac
  done
  case "$days" in ''|*[!0-9]*) die "stats: --days takes a number" ;; esac
  local f
  f="$(co_state_dir)/stats.jsonl"
  [ -s "$f" ] || { echo "No offload activity recorded yet ($f)."; return 0; }
  if $csv; then
    # every record, one row each, fixed columns (same as the TypeScript engine)
    echo "ts,kind,source,event,model,files,bytes_in,bytes_out,saved_tokens,seconds,cites_ok,cites_bad,worker_tokens_in,worker_tokens_out,model_tried,model_ok,label,file,log"
    jq -r --argjson days "$days" '(now - ($days * 86400)) as $since
      | select($days == 0 or .ts >= $since) | [.ts, .kind, .source, .event, .model, .files, .bytes_in, .bytes_out, .saved_tokens, .seconds, .cites_ok, .cites_bad, .worker_tokens_in, .worker_tokens_out, .model_tried, .model_ok, .label, .file, .log] | @csv' "$f"
    return 0
  fi
  if $json; then
    # same shape as the TypeScript engine's --json
    jq -s --argjson days "$days" '
      (now - ($days * 86400)) as $since
      | map(select($days == 0 or .ts >= $since))
      | ([.[] | select(.kind == "hook" and ((.event // "") | endswith("blocked")))] | length) as $blocked
      | map(select(.kind != "hook"))
      | def sum(f): map(f // 0) | add // 0;
        {delegations: length, saved_tokens: sum(.saved_tokens), worker_tokens_in: sum(.worker_tokens_in),
         worker_tokens_out: sum(.worker_tokens_out), blocked_reads: $blocked,
         # per model: latency (nearest rank) and citation health, for rows a model answered
         by_model: (map(select((.model // "") != "")) | group_by(.model)
           | map((map(.seconds // 0) | sort) as $s | {key: .[0].model, value: {count: length,
               p50_seconds: $s[((length * 0.5) | ceil) - 1], p95_seconds: $s[((length * 0.95) | ceil) - 1],
               cites_ok: sum(.cites_ok), cites_bad: sum(.cites_bad)}}) | from_entries),
         by_kind: (group_by(.kind + (if .source then ":" + .source else "" end))
           | map({key: (.[0].kind + (if .[0].source then ":" + .[0].source else "" end)), value: {count: length, saved_tokens: sum(.saved_tokens)}})
           | from_entries)}' "$f"
    return 0
  fi
  jq -rs --argjson days "$days" '
    (now - ($days * 86400)) as $since
    | map(select($days == 0 or .ts >= $since))
    | . as $all
    | def fmt: tostring | if length <= 3 then . else (.[:-3] | fmt) + "," + .[-3:] end;
      def sum(f): map(f // 0) | add // 0;
      ($all | map(select(.kind != "hook"))) as $del
    | "offload stats" + (if $days > 0 then " (last \($days) days)" else " (all time)" end),
      "  delegations: \($del | length)   est. Claude tokens kept out of context: \($del | sum(.saved_tokens) | floor | fmt)",
      "  worker tokens used (as the workers reported them): in \($del | sum(.worker_tokens_in) | fmt) / out \($del | sum(.worker_tokens_out) | fmt)",
      "",
      "  kind               count   saved≈tok   avg s   model-failures",
      ($del | group_by(.kind + (if .source then ":" + .source else "" end))[] |
        "  \((.[0].kind + (if .[0].source then ":" + .[0].source else "" end)) | .[0:17] | . + (" " * (17 - length)))  \(length | tostring | (" " * (6 - length)) + .)   \(sum(.saved_tokens) | floor | fmt | (" " * (9 - length)) + .)   \((sum(.seconds) / length * 10 | floor) / 10 | tostring | (" " * (5 - length)) + .)   \(map(select(.model_ok == false and .model_tried != false)) | length)"),
      "",
      ((now / 86400 | floor) as $today
        | [range(13; -1; -1) as $i | ($today - $i) as $d | $del | map(select((.ts / 86400 | floor) == $d)) | sum(.saved_tokens)] as $per
        | ([$per[], 1] | max) as $max
        | "  last 14 days  " + ($per | map(if . == 0 then "·" else ([9601 + ([7, (. / $max * 7.999 | floor)] | min)] | implode) end) | join("")) + "  (today \($per[13] | floor | fmt) tok)"),
      "",
      "  hook events: \($all | map(select(.kind == "hook")) | group_by(.event) | map("\(.[0].event)=\(length)") | join("  "))",
      "  citations: \($del | sum(.cites_ok)) verified, \($del | sum(.cites_bad)) unverified",
      "  blocked reads: \($all | map(select(.kind == "hook" and ((.event // "") | endswith("blocked")))) | length) (each costs the agent one more turn; not subtracted above)"
  ' "$f"
  echo "  (estimates: bytes/4 of what was kept out of context; cache effects are not counted)"
}

cmd_statusline() {
  local f since
  f="$(co_state_dir)/stats.jsonl"
  since=$(( $(co_now) - $(co_now) % 86400 ))
  if [ -s "$f" ]; then
    jq -rs --argjson since "$since" '
      map(select(.kind != "hook" and .ts >= $since)) as $r
      | ($r | map(.saved_tokens // 0) | add // 0) as $s
      | "▌offload \($r | length) · ~\(if $s >= 1000 then ((($s / 100) | floor) / 10 | tostring) + "k" else ($s | tostring) end) saved today"' "$f"
  else
    echo "▌offload 0 · ~0 saved today"
  fi
}

# ---------------------------------------------------------------- config

cmd_config() {
  local sub="${1:-show}"
  [ $# -gt 0 ] && shift
  local target
  target=$(co_user_config_path)
  local args=() a
  for a in "$@"; do
    if [ "$a" = "--project" ]; then target=$(co_project_config_path); else args+=("$a"); fi
  done
  case "$sub" in
    show)
      co_config_load
      echo "# defaults: $CO_ROOT/config/defaults.json"
      echo "# user:     $(co_user_config_path)$([ -f "$(co_user_config_path)" ] || echo ' (absent)')"
      echo "# project:  $(co_project_config_path)$([ -f "$(co_project_config_path)" ] || echo ' (absent)')"
      local ign; ign=$(co_project_config_ignored)
      [ -n "$ign" ] && echo "# project keys ignored (untrusted repo; \`offload config trust\` to allow): $ign"
      # API keys stay out of terminals and logs
      printf '%s\n' "$CO_CONFIG" | jq '(.endpoints // {}) |= with_entries(if (.value | type) == "object" and .value.api_key then .value.api_key = "***" else . end)' ;;
    trust)
      local dir cur
      dir=$(co_project_dir)
      target=$(co_user_config_path)
      mkdir -p "$(dirname "$target")"
      cur='{}'; [ -f "$target" ] && cur=$(cat "$target")
      printf '%s' "$cur" | jq -e 'type == "object"' >/dev/null 2>&1 || die "config trust: $target is not valid JSON; fix it first"
      (umask 077; printf '%s' "$cur" | jq --arg d "$dir" '.trusted_projects = (((.trusted_projects // []) + [$d]) | unique)' > "$target.tmp") && mv "$target.tmp" "$target"
      echo "trusted $dir: its .harness-offload.json may now set binaries, endpoints and privacy options" ;;
    path)
      echo "$target" ;;
    get)
      if [ -f "$target" ]; then jq . "$target"; else echo '{}'; fi ;;
    init)
      if [ -f "$target" ]; then die "config init: $target already exists (edit it, or use: offload config set KEY VALUE)"; fi
      mkdir -p "$(dirname "$target")"
      cat > "$target" <<'EOF'
{
  "models": {
    "default": "",
    "read": "",
    "explore": "",
    "summarize": "",
    "write": "",
    "fallback": []
  },
  "hooks": {
    "read_guard": "block",
    "read_threshold_lines": 600,
    "read_threshold_tokens": 6000,
    "summarize_bash_output": true
  }
}
EOF
      echo "wrote $target — set models with: offload config set models.default PROVIDER/MODEL (see: opencode models)" ;;
    set)
      [ ${#args[@]} -ge 2 ] || die "config set KEY VALUE [--project]   e.g. offload config set models.read opencode-go/glm-5.3-flash"
      local key="${args[0]}" val="${args[1]}" cur
      mkdir -p "$(dirname "$target")"
      cur='{}'
      [ -f "$target" ] && cur=$(cat "$target")
      printf '%s' "$cur" | jq -e 'type == "object"' >/dev/null 2>&1 || die "config set: $target is not valid JSON; fix it first"
      (umask 077; printf '%s' "$cur" | jq --arg k "$key" --arg v "$val" '
        setpath($k | split("."); ($v | try fromjson catch $v))' > "$target.tmp") && mv "$target.tmp" "$target"
      echo "set $key = $val in $target"
      # warn (still saved: maps like endpoints.NAME are open) when the key is not a known setting
      local chk s1
      co_tmp chk; jq -n --arg k "$key" 'setpath($k | split("."); 0)' > "$chk"
      s1=$(co_config_unknown "$chk")
      [ -n "$s1" ] && co_err "warning: $key is not a known setting$(s=$(printf '%s' "$s1" | cut -f2); [ -n "$s" ] && printf ' (did you mean %s?)' "$s"); it was saved, but nothing reads it" ;;
    validate)
      local n=0 checked="" k s f
      for f in "$(co_user_config_path)" "$(co_project_config_path)"; do
        [ -f "$f" ] || continue
        checked="$checked${checked:+, }$f"
        while IFS="$(printf '\t')" read -r k s; do
          [ -n "$k" ] || continue
          n=$((n + 1)); echo "unknown key in $f: $k${s:+ (did you mean $s?)}"
        done <<EOF2
$(co_config_unknown "$f")
EOF2
      done
      if [ "$n" -gt 0 ]; then echo "$n unknown key(s): offload ignores them (a typo is not applied)"; return 1; fi
      echo "config ok: every key is known (${checked:-no config files yet})" ;;
    *) die "config: unknown subcommand $sub (show|path|init|get|set|validate|trust)" ;;
  esac
}

# ------------------------------------------------------------------ main

main() {
  local cmd="${1:-help}" topic=""
  [ $# -gt 0 ] && shift
  # per-command help (shared text with the TypeScript engine): `offload help read`, `offload read --help`
  if [ "$cmd" = help ]; then topic="${1:-}"; else case "${1:-}" in --help|-h) topic=$cmd ;; esac; fi
  case "$topic" in ''|_*) ;; *)
    if jq -e --arg t "$topic" '.[$t] | type == "string"' "$CO_ROOT/config/help.json" >/dev/null 2>&1; then
      jq -r --arg t "$topic" '.[$t]' "$CO_ROOT/config/help.json"; return 0
    fi ;;
  esac
  case "$cmd" in
    help|-h|--help) usage; return 0 ;;
    version|-v|--version) echo "offload $CO_VERSION"; return 0 ;;
  esac
  need_jq
  co_config_load
  case "$cmd" in
    read|bulk-read)  cmd_read "$@" ;;
    explore)         cmd_explore "$@" ;;
    run)             cmd_run "$@" ;;
    summarize|digest) cmd_summarize "$@" ;;
    write|code-write) cmd_write "$@" ;;
    ask)             cmd_ask "$@" ;;
    outline)         [ "${1:-}" = "--" ] && shift; [ -f "${1:-}" ] || die "outline: give a file"; co_outline "$1" "${2:-80}" ;;
    doctor)
      # --json is the TypeScript doctor's machine format: forward it, so both engines print the same JSON
      case " $* " in *" --json "*)
        local rc; co_ts_run doctor "$@"; rc=$?
        [ "$rc" = "$CO_E_NOOC" ] && ! co_ts_cli >/dev/null && die "doctor --json needs Node.js 18+ (it is part of the bundled TypeScript CLI)" "$CO_E_NOOC"
        return "$rc" ;;
      esac
      cmd_doctor "$@" ;;
    stats)           cmd_stats "$@" ;;
    explain)         cmd_explain "$@" ;;
    statusline)      cmd_statusline ;;
    dashboard)       co_ts_run dashboard "$@" || die "dashboard needs Node.js 18+ (the report is built by the bundled TypeScript CLI)" "$CO_E_NOOC" ;;
    config)          cmd_config "$@" ;;
    task)            cmd_task "$@" ;;
    tasks)           cmd_tasks "$@" ;;
    model)           cmd_model "$@" ;;
    key)             cmd_key "$@" ;;
    # interactive and host-integration commands live in the bundled TypeScript CLI
    setup|models|install|uninstall|sync|mcp|demo|worker|hook)
                     local rc; co_ts_run "$cmd" "$@"; rc=$?
                     [ "$rc" = "$CO_E_NOOC" ] && ! co_ts_cli >/dev/null && die "$cmd needs Node.js 18+ (it is part of the bundled TypeScript CLI)" "$CO_E_NOOC"
                     return "$rc" ;;
    *) co_err "unknown command: $cmd"; usage >&2; return "$CO_E_USAGE" ;;
  esac
}

main "$@"
