{
  "_comment": "HTTP endpoint presets, the default cheap model per harness for the @host model ref, and the API-key backup per harness for @host-api. Shared by the bash and TypeScript engines; override with `endpoints` / `host_models` / `host_api_models` in your config.",
  "endpoints": {
    "openai": {
      "type": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "label": "OpenAI API"
    },
    "openrouter": {
      "type": "openai",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "label": "OpenRouter"
    },
    "anthropic": {
      "type": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY",
      "label": "Anthropic API"
    },
    "google": {
      "type": "openai",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "api_key_env": "GEMINI_API_KEY",
      "label": "Google AI Studio (Gemini API)"
    },
    "groq": {
      "type": "openai",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_env": "GROQ_API_KEY",
      "label": "Groq"
    },
    "deepseek": {
      "type": "openai",
      "base_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY",
      "label": "DeepSeek"
    },
    "mistral": {
      "type": "openai",
      "base_url": "https://api.mistral.ai/v1",
      "api_key_env": "MISTRAL_API_KEY",
      "label": "Mistral"
    },
    "together": {
      "type": "openai",
      "base_url": "https://api.together.xyz/v1",
      "api_key_env": "TOGETHER_API_KEY",
      "label": "Together AI"
    },
    "fireworks": {
      "type": "openai",
      "base_url": "https://api.fireworks.ai/inference/v1",
      "api_key_env": "FIREWORKS_API_KEY",
      "label": "Fireworks"
    },
    "cerebras": {
      "type": "openai",
      "base_url": "https://api.cerebras.ai/v1",
      "api_key_env": "CEREBRAS_API_KEY",
      "label": "Cerebras"
    },
    "xai": {
      "type": "openai",
      "base_url": "https://api.x.ai/v1",
      "api_key_env": "XAI_API_KEY",
      "label": "xAI"
    },
    "zai": {
      "type": "openai",
      "base_url": "https://api.z.ai/api/paas/v4",
      "api_key_env": "ZAI_API_KEY",
      "label": "Z.ai (GLM)"
    },
    "moonshot": {
      "type": "openai",
      "base_url": "https://api.moonshot.ai/v1",
      "api_key_env": "MOONSHOT_API_KEY",
      "label": "Moonshot (Kimi)"
    },
    "ollama": {
      "type": "openai",
      "base_url": "http://127.0.0.1:11434/v1",
      "label": "Ollama (local)"
    },
    "lmstudio": {
      "type": "openai",
      "base_url": "http://127.0.0.1:1234/v1",
      "label": "LM Studio (local)"
    },
    "vllm": {
      "type": "openai",
      "base_url": "http://127.0.0.1:8000/v1",
      "label": "vLLM (local)"
    },
    "dashscope": {
      "type": "openai",
      "base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
      "api_key_env": "DASHSCOPE_API_KEY",
      "label": "Alibaba Model Studio (Qwen)"
    },
    "github": {
      "type": "openai",
      "base_url": "https://models.github.ai/inference",
      "api_key_env": "GITHUB_TOKEN",
      "label": "GitHub Models"
    }
  },
  "host_models": {
    "claude": "claude:haiku",
    "codex": "codex:gpt-6-luna",
    "gemini": "gemini:flash-lite",
    "cursor": "cursor:",
    "pi": "pi:",
    "opencode": "@default",
    "kilo": "@default",
    "devin": "claude:haiku",
    "copilot": "copilot:",
    "qwen": "qwen:",
    "crush": "crush:",
    "amp": "@default"
  },
  "host_api_models": {
    "claude": "anthropic:claude-haiku-5-5",
    "devin": "anthropic:claude-haiku-5-5",
    "codex": "openai:gpt-6-luna",
    "gemini": "google:gemini-flash-lite-latest",
    "qwen": "dashscope:qwen-flash",
    "copilot": "github:openai/gpt-4.1-mini"
  },
  "worker_names": {
    "_comment": "How offload names a worker for the user, e.g. \"Haiku on your Claude plan\".",
    "plans": {
      "claude": "your Claude plan",
      "codex": "your ChatGPT plan",
      "gemini": "your Google account",
      "cursor": "your Cursor plan",
      "copilot": "your Copilot plan",
      "qwen": "your Qwen Code login",
      "pi": "Pi's own login",
      "crush": "Crush's own setup"
    },
    "models": {
      "haiku": "Haiku",
      "sonnet": "Sonnet",
      "opus": "Opus",
      "flash-lite": "Gemini Flash-Lite",
      "flash": "Gemini Flash"
    }
  }
}
