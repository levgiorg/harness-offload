{
  "name": "harness-offload",
  "version": "0.2.0",
  "description": "The harness offloader: keep bulk I/O out of your coding agent's context by delegating it to cheap models you already pay for.",
  "license": "MIT",
  "author": "George Levis",
  "homepage": "https://github.com/levgiorg/harness-offload#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levgiorg/harness-offload.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/levgiorg/harness-offload/issues",
  "keywords": [
    "ai",
    "claude-code",
    "codex",
    "coding-agent",
    "context",
    "cursor",
    "gemini-cli",
    "mcp",
    "opencode",
    "pi",
    "pi-package",
    "token-optimization"
  ],
  "type": "module",
  "bin": {
    "offload": "dist/cli.js",
    "harness-offload": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "LICENSE-FONTS"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "gen": "node scripts/gen-assets.mjs",
    "prebuild": "node scripts/gen-assets.mjs",
    "build": "bun run scripts/build.ts",
    "pretypecheck": "node scripts/gen-assets.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/gen-assets.mjs",
    "test": "bun test",
    "compile": "bun run scripts/compile.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typebox": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./dist/pi.js"
    ]
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  }
}
